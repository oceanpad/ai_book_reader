# Server-only settings. Never prefix provider credentials with VITE_.
# Copy to .env for local development; only the API loads these values.
# Plain export OPENAI_API_KEY=... / OPENROUTER_API_KEY=... in .envrc also works.
READER_MODE=local
READER_AWS_REGION=ap-southeast-1
# Optional, only for direct OpenAI benchmark routes:
READER_OPENAI_API_KEY=
READER_OPENROUTER_API_KEY=
# Candidate settings: a synthetic smoke check passed, full M1 evaluation is pending.
READER_VISION_MODEL=google/gemini-3.5-flash-lite
READER_SPEECH_MODEL=google/gemini-3.8-flash-tts
READER_SPEECH_VOICE=Aoede
READER_SPEECH_PROVIDER=openrouter
READER_SPEECH_PCM_RATE=24000
READER_SPEECH_CHUNK_CHARACTERS=1000
READER_PROVIDER_TIMEOUT_SECONDS=60
# Optional nested overrides, validated at API startup:
# READER_CAMERA__STABLE_WINDOW_MS=1000
# READER_LIMITS__MAX_CAPTURES_AHEAD=3
