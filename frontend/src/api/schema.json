{
  "$defs": {
    "AudioState": {
      "enum": [
        "AUDIO_PENDING",
        "READY",
        "AUDIO_FAILED"
      ],
      "title": "AudioState",
      "type": "string"
    },
    "Book": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "level": {
          "anyOf": [
            {
              "$ref": "#/$defs/BookLevel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "language": {
          "anyOf": [
            {
              "$ref": "#/$defs/BookLanguage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "created_at": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Book creation time in Unix milliseconds, estimated from the earliest saved page for legacy books",
          "title": "Created At"
        },
        "cover": {
          "anyOf": [
            {
              "$ref": "#/$defs/BookCover"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "read_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Read Count"
        }
      },
      "required": [
        "name",
        "id"
      ],
      "title": "Book",
      "type": "object"
    },
    "BookCover": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "page_id": {
          "title": "Page Id",
          "type": "string"
        },
        "thumbnail_url": {
          "title": "Thumbnail Url",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "page_id",
        "thumbnail_url"
      ],
      "title": "BookCover",
      "type": "object"
    },
    "BookLanguage": {
      "enum": [
        "en",
        "zh"
      ],
      "title": "BookLanguage",
      "type": "string"
    },
    "BookLevel": {
      "enum": [
        "P1",
        "P2",
        "P3",
        "P4",
        "P5",
        "P6"
      ],
      "title": "BookLevel",
      "type": "string"
    },
    "BookPageMove": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "page_id": {
          "format": "uuid",
          "title": "Page Id",
          "type": "string"
        },
        "page_number": {
          "minimum": 1,
          "title": "Page Number",
          "type": "integer"
        }
      },
      "required": [
        "run_id",
        "page_id",
        "page_number"
      ],
      "title": "BookPageMove",
      "type": "object"
    },
    "BookPageOrder": {
      "additionalProperties": false,
      "properties": {
        "page_order": {
          "description": "Capture keys in book order, formatted as run/page",
          "items": {
            "type": "string"
          },
          "title": "Page Order",
          "type": "array"
        }
      },
      "required": [
        "page_order"
      ],
      "title": "BookPageOrder",
      "type": "object"
    },
    "BookUpdate": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "level": {
          "anyOf": [
            {
              "$ref": "#/$defs/BookLevel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "language": {
          "anyOf": [
            {
              "$ref": "#/$defs/BookLanguage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "BookUpdate",
      "type": "object"
    },
    "Books": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/Book"
          },
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "items"
      ],
      "title": "Books",
      "type": "object"
    },
    "CameraConfig": {
      "additionalProperties": false,
      "properties": {
        "samples_per_second": {
          "default": 4,
          "maximum": 10,
          "minimum": 1,
          "title": "Samples Per Second",
          "type": "integer"
        },
        "stable_window_ms": {
          "default": 1000,
          "maximum": 5000,
          "minimum": 250,
          "title": "Stable Window Ms",
          "type": "integer"
        },
        "motion_threshold": {
          "default": 0.025,
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Motion Threshold",
          "type": "number"
        },
        "scene_change_threshold": {
          "default": 0.12,
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Scene Change Threshold",
          "type": "number"
        },
        "sharpness_threshold": {
          "default": 100,
          "exclusiveMinimum": 0,
          "title": "Sharpness Threshold",
          "type": "number"
        },
        "min_crop_width": {
          "default": 640,
          "minimum": 320,
          "title": "Min Crop Width",
          "type": "integer"
        },
        "min_crop_height": {
          "default": 480,
          "minimum": 240,
          "title": "Min Crop Height",
          "type": "integer"
        },
        "max_longest_edge": {
          "default": 2560,
          "maximum": 4096,
          "minimum": 640,
          "title": "Max Longest Edge",
          "type": "integer"
        },
        "max_upload_bytes": {
          "default": 4194304,
          "maximum": 4194304,
          "minimum": 65536,
          "title": "Max Upload Bytes",
          "type": "integer"
        }
      },
      "required": [
        "samples_per_second",
        "stable_window_ms",
        "motion_threshold",
        "scene_change_threshold",
        "sharpness_threshold",
        "min_crop_width",
        "min_crop_height",
        "max_longest_edge",
        "max_upload_bytes"
      ],
      "title": "CameraConfig",
      "type": "object"
    },
    "CaptureStage": {
      "enum": [
        "validate",
        "vision",
        "deduplicate",
        "speech"
      ],
      "title": "CaptureStage",
      "type": "string"
    },
    "CaptureState": {
      "enum": [
        "UPLOADING",
        "QUEUED",
        "PROCESSING",
        "READY",
        "DUPLICATE",
        "REJECTED",
        "FAILED",
        "CANCELLED"
      ],
      "title": "CaptureState",
      "type": "string"
    },
    "Health": {
      "additionalProperties": false,
      "properties": {
        "ok": {
          "const": true,
          "default": true,
          "title": "Ok",
          "type": "boolean"
        },
        "service": {
          "const": "ai-book-reader",
          "default": "ai-book-reader",
          "title": "Service",
          "type": "string"
        }
      },
      "required": [
        "ok",
        "service"
      ],
      "title": "Health",
      "type": "object"
    },
    "HomeworkEntry": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "subject": {
          "enum": [
            "math",
            "english",
            "chinese"
          ],
          "title": "Subject",
          "type": "string"
        },
        "level": {
          "enum": [
            "kindergarten",
            "primary1",
            "primary2",
            "primary3",
            "primary4",
            "primary5",
            "primary6"
          ],
          "title": "Level",
          "type": "string"
        },
        "state": {
          "enum": [
            "pending",
            "ready",
            "failed"
          ],
          "title": "State",
          "type": "string"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/HomeworkResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        }
      },
      "required": [
        "id",
        "created_at",
        "subject",
        "level",
        "state",
        "result",
        "error"
      ],
      "title": "HomeworkEntry",
      "type": "object"
    },
    "HomeworkHistory": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/HomeworkEntry"
          },
          "title": "Items",
          "type": "array"
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Cursor"
        }
      },
      "required": [
        "items",
        "next_cursor"
      ],
      "title": "HomeworkHistory",
      "type": "object"
    },
    "HomeworkQuestion": {
      "additionalProperties": false,
      "properties": {
        "question": {
          "maxLength": 800,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "answer": {
          "maxLength": 800,
          "minLength": 1,
          "title": "Answer",
          "type": "string"
        },
        "steps": {
          "items": {
            "maxLength": 400,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 6,
          "title": "Steps",
          "type": "array"
        },
        "language": {
          "enum": [
            "en",
            "zh"
          ],
          "title": "Language",
          "type": "string"
        }
      },
      "required": [
        "question",
        "answer",
        "steps",
        "language"
      ],
      "title": "HomeworkQuestion",
      "type": "object"
    },
    "HomeworkResult": {
      "additionalProperties": false,
      "properties": {
        "questions": {
          "items": {
            "$ref": "#/$defs/HomeworkQuestion"
          },
          "title": "Questions",
          "type": "array"
        },
        "note": {
          "maxLength": 500,
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "questions",
        "note"
      ],
      "title": "HomeworkResult",
      "type": "object"
    },
    "HomeworkSubmission": {
      "additionalProperties": false,
      "properties": {
        "subject": {
          "enum": [
            "math",
            "english",
            "chinese"
          ],
          "title": "Subject",
          "type": "string"
        },
        "level": {
          "enum": [
            "kindergarten",
            "primary1",
            "primary2",
            "primary3",
            "primary4",
            "primary5",
            "primary6"
          ],
          "title": "Level",
          "type": "string"
        },
        "images": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Images",
          "type": "array"
        }
      },
      "required": [
        "subject",
        "level",
        "images"
      ],
      "title": "HomeworkSubmission",
      "type": "object"
    },
    "Limits": {
      "additionalProperties": false,
      "properties": {
        "max_captures_ahead": {
          "default": 10,
          "maximum": 10,
          "minimum": 1,
          "title": "Max Captures Ahead",
          "type": "integer"
        },
        "max_pages_per_session": {
          "default": 100,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Pages Per Session",
          "type": "integer"
        },
        "capture_attempts_per_day": {
          "default": 200,
          "maximum": 200,
          "minimum": 1,
          "title": "Capture Attempts Per Day",
          "type": "integer"
        },
        "speech_attempts_per_day": {
          "default": 200,
          "maximum": 200,
          "minimum": 1,
          "title": "Speech Attempts Per Day",
          "type": "integer"
        },
        "stage_attempts": {
          "default": 3,
          "maximum": 3,
          "minimum": 1,
          "title": "Stage Attempts",
          "type": "integer"
        }
      },
      "required": [
        "max_captures_ahead",
        "max_pages_per_session",
        "capture_attempts_per_day",
        "speech_attempts_per_day",
        "stage_attempts"
      ],
      "title": "Limits",
      "type": "object"
    },
    "PlayableCapture": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "created_at": {
          "description": "Capture creation time in Unix seconds",
          "title": "Created At",
          "type": "integer"
        },
        "narration": {
          "title": "Narration",
          "type": "string"
        },
        "language": {
          "title": "Language",
          "type": "string"
        },
        "audio_chunks": {
          "description": "Zero while speech is unavailable",
          "minimum": 0,
          "title": "Audio Chunks",
          "type": "integer"
        },
        "state": {
          "anyOf": [
            {
              "$ref": "#/$defs/CaptureState"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Omitted for READY pages"
        },
        "retryable": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retryable"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "thumbnail_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thumbnail Url"
        }
      },
      "required": [
        "id",
        "run_id",
        "created_at",
        "narration",
        "language",
        "audio_chunks",
        "thumbnail_url"
      ],
      "title": "PlayableCapture",
      "type": "object"
    },
    "PublicConfig": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "local",
            "aws"
          ],
          "title": "Mode",
          "type": "string"
        },
        "camera": {
          "$ref": "#/$defs/CameraConfig"
        },
        "limits": {
          "$ref": "#/$defs/Limits"
        },
        "recognition_available": {
          "default": false,
          "title": "Recognition Available",
          "type": "boolean"
        },
        "speech_available": {
          "default": false,
          "title": "Speech Available",
          "type": "boolean"
        },
        "setup_message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Setup Message"
        }
      },
      "required": [
        "mode",
        "camera",
        "limits",
        "recognition_available",
        "speech_available",
        "setup_message"
      ],
      "title": "PublicConfig",
      "type": "object"
    },
    "ReadingJob": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/CaptureState"
        },
        "stage": {
          "$ref": "#/$defs/CaptureStage"
        },
        "narration": {
          "default": "",
          "title": "Narration",
          "type": "string"
        },
        "language": {
          "default": "",
          "title": "Language",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "audio_chunks": {
          "default": 0,
          "title": "Audio Chunks",
          "type": "integer"
        },
        "vision_model": {
          "title": "Vision Model",
          "type": "string"
        },
        "speech_model": {
          "title": "Speech Model",
          "type": "string"
        },
        "voice": {
          "title": "Voice",
          "type": "string"
        },
        "prompt_version": {
          "default": "reader-vision-v3",
          "title": "Prompt Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "state",
        "stage",
        "narration",
        "language",
        "reason",
        "retryable",
        "audio_chunks",
        "vision_model",
        "speech_model",
        "voice",
        "prompt_version"
      ],
      "title": "ReadingJob",
      "type": "object"
    },
    "RecentCaptures": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/PlayableCapture"
          },
          "maxItems": 10,
          "title": "Items",
          "type": "array"
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Cursor"
        },
        "page_order": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Saved book order, included only on the first batch when set",
          "title": "Page Order"
        }
      },
      "required": [
        "items",
        "next_cursor"
      ],
      "title": "RecentCaptures",
      "type": "object"
    },
    "SessionState": {
      "enum": [
        "ACTIVE",
        "STOPPED",
        "DELETING"
      ],
      "title": "SessionState",
      "type": "string"
    },
    "VisionResult": {
      "additionalProperties": false,
      "properties": {
        "is_book_page": {
          "title": "Is Book Page",
          "type": "boolean"
        },
        "text_state": {
          "enum": [
            "readable",
            "absent",
            "unreadable"
          ],
          "title": "Text State",
          "type": "string"
        },
        "ocr_text": {
          "maxLength": 20000,
          "title": "Ocr Text",
          "type": "string"
        },
        "illustration_description": {
          "maxLength": 1000,
          "title": "Illustration Description",
          "type": "string"
        },
        "language": {
          "maxLength": 35,
          "minLength": 2,
          "title": "Language",
          "type": "string"
        },
        "needs_retake": {
          "title": "Needs Retake",
          "type": "boolean"
        },
        "retake_reason": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Retake Reason"
        }
      },
      "required": [
        "is_book_page",
        "text_state",
        "ocr_text",
        "illustration_description",
        "language",
        "needs_retake",
        "retake_reason"
      ],
      "title": "VisionResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "homework_submission": {
      "$ref": "#/$defs/HomeworkSubmission"
    },
    "homework_history": {
      "$ref": "#/$defs/HomeworkHistory"
    },
    "recent_captures": {
      "$ref": "#/$defs/RecentCaptures"
    },
    "public_config": {
      "$ref": "#/$defs/PublicConfig"
    },
    "health": {
      "$ref": "#/$defs/Health"
    },
    "capture_state": {
      "$ref": "#/$defs/CaptureState"
    },
    "capture_stage": {
      "$ref": "#/$defs/CaptureStage"
    },
    "session_state": {
      "$ref": "#/$defs/SessionState"
    },
    "audio_state": {
      "$ref": "#/$defs/AudioState"
    },
    "vision_result": {
      "$ref": "#/$defs/VisionResult"
    },
    "reading_job": {
      "$ref": "#/$defs/ReadingJob"
    },
    "books": {
      "$ref": "#/$defs/Books"
    },
    "book_update": {
      "$ref": "#/$defs/BookUpdate"
    },
    "book_page_move": {
      "$ref": "#/$defs/BookPageMove"
    },
    "book_page_order": {
      "$ref": "#/$defs/BookPageOrder"
    }
  },
  "required": [
    "homework_submission",
    "homework_history",
    "recent_captures",
    "public_config",
    "health",
    "capture_state",
    "capture_stage",
    "session_state",
    "audio_state",
    "vision_result",
    "reading_job",
    "books",
    "book_update",
    "book_page_move",
    "book_page_order"
  ],
  "title": "ReaderContracts",
  "type": "object"
}
